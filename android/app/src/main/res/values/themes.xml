<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#000000</color>
    <color name="mint">#1DF0BB</color>
    <color name="ink">#080A09</color>
    <color name="text">#F2F5F4</color>
    <color name="muted">#A3ADAA</color>
    <color name="danger">#FF8A80</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <style name="PrimaryButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
    </style>
</resources>
